# docker/legacy-tier/.env.example
# Legacy tier environment template (decision D-2026-08-15: dockerize the
# replaced Express servers so they can be deployed to another machine).
# Copy to .env and edit for the target deployment. The services reuse the
# schemas that already exist on the PG instance they point at — they do NOT
# create or migrate them.

# ── PostgreSQL ────────────────────────────────────────────────────────────
PG_HOST=postgres
PG_PORT=5432
PG_USER=pguser
PG_PASS=pgpass
PG_DB_NAME=nexus

# DSN forms used by the legacy units (point at the same PG instance above)
NEXUS_PG_DSN=postgres://pguser:pgpass@postgres:5432/nexus
TACKLE_PG_DSN=postgres://pguser:pgpass@postgres:5432/nexus
CONDUIT_PG_DSN=postgres://pguser:pgpass@postgres:5432/nexus
PEB_PG_DSN=postgres://pguser:pgpass@postgres:5432/nexus
PROMPT_PG_DSN=postgres://pguser:pgpass@postgres:5432/nexus
MEMORY_PG_DSN=postgres://pguser:pgpass@postgres:5432/nexus

# ── Redis ─────────────────────────────────────────────────────────────────
MEMORY_REDIS_URL=redis://redis:6379
PROMPT_REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# ── Ports (host:container mapping; defaults match the original units) ─────
WIND_SRV_PORT=3300
TACKLE_SRV_PORT=3410
KERNEL_SRV_PORT=8100
PEB_SRV_PORT=3111
CASCADE_SRV_PORT=3106
HARNESS_SRV_PORT=3420
PTY_SRV_PORT=3120
EXECUTION_SRV_PORT=3110
PROMPT_SRV_PORT=3501
MEMORY_SRV_PORT=3500

# ── Harness specifics (agent subprocess spawning) ─────────────────────────
HARNESS_WORK_DIR=/nexus
NEXUS_LOG_DIR=/nexus/logs
OPENCODE_BIN=opencode
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
NEBULA_URL=http://legacy-nebula:3101
CONDUIT_MCP_URL=http://legacy-conduit:3100

# ── tackle-srv extras ─────────────────────────────────────────────────────
PIPELINE_ROOT=/nexus
MEMORY_SRV_URL=http://legacy-memory:3500
