{
  "@context": {
    "@version": 1.1,
    "nx": "https://nexus.local/schema/",

    "pl": "https://nexus.local/schema/ontology/core/plan/",
    "id": "@id",
    "type": "@type",
    "comment": {"@id": "http://www.w3.org/2000/01/rdf-schema#comment"},

    "Plan":            "pl:Plan",
    "PlanTicket":      "pl:PlanTicket",
    "PlanReceipt":     "pl:PlanReceipt",
    "ReceiptType":     "pl:ReceiptType",

    "planNumber":   "pl:planNumber",
    "project":      "pl:project",
    "goal":         "pl:goal",
    "filesAffected":  {"@id": "pl:filesAffected", "@container": "@set"},
    "acceptanceCriteria": {"@id": "pl:acceptanceCriteria", "@container": "@list"},
    "isBlocked":    {"@id": "pl:isBlocked", "@type": "xsd:boolean"},
    "blockReason":  "pl:blockReason",
    "planStatus":   "pl:planStatus",
    "planVersion":  {"@id": "pl:planVersion", "@type": "xsd:integer"},

    "ticketUID":       "pl:ticketUID",
    "ticketType":      "pl:ticketType",
    "ticketStatus":    "pl:ticketStatus",
    "assignedRole":    "pl:assignedRole",
    "assignedModel":   "pl:assignedModel",
    "claimedAt":       {"@id": "pl:claimedAt", "@type": "xsd:dateTime"},
    "completedAt":     {"@id": "pl:completedAt", "@type": "xsd:dateTime"},

    "receiptType":     "pl:receiptType",
    "agentRole":       "pl:agentRole",
    "sessionId":       "pl:sessionId",
    "artifactPath":    "pl:artifactPath",
    "summary":         "pl:summary",
    "receiptTimestamp": {"@id": "pl:receiptTimestamp", "@type": "xsd:dateTime"}
  },

  "@graph": [
    {
      "@id": "pl:Plan",
      "@type": "rdfs:Class",
      "subClassOf": {"@id": "nx:Plan"},
      "comment": "An implementation plan in the conduit pipeline. Goes through lifecycle: PROPOSED → PLANNING → PENDING → ACTIVE → REVIEW → COMPLETED or BLOCKED.",
      "properties": [
        "pl:planNumber", "nx:title", "pl:project", "pl:goal",
        "pl:filesAffected", "pl:acceptanceCriteria",
        "nx:status", "pl:planStatus", "pl:isBlocked", "pl:blockReason",
        "nx:createdAt", "nx:updatedAt", "pl:planVersion",
        "nx:dependsOn", "nx:derivedFrom", "nx:hasPart",
        "nx:assignedTo", "nx:tags", "nx:references"
      ]
    },
    {
      "@id": "pl:PlanTicket",
      "@type": "rdfs:Class",
      "comment": "A ticket spawned from a plan for assignment to a specific agent role.",
      "properties": [
        "pl:ticketUID", "pl:planNumber", "pl:ticketType", "pl:ticketStatus",
        "pl:assignedRole", "pl:assignedModel",
        "nx:createdAt", "pl:claimedAt", "pl:completedAt",
        "pl:isBlocked", "nx:assignedTo"
      ]
    },
    {
      "@id": "pl:PlanReceipt",
      "@type": "rdfs:Class",
      "comment": "An immutable audit receipt for a plan lifecycle transition.",
      "properties": [
        "pl:planNumber", "pl:receiptType", "pl:agentRole",
        "pl:sessionId", "pl:artifactPath", "pl:summary",
        "pl:receiptTimestamp", "nx:timestamp"
      ]
    },
    {
      "@id": "pl:ReceiptType",
      "@type": "rdfs:Class",
      "comment": "Enumeration of receipt types that drive pipeline transitions.",
      "properties": []
    }
  ]
}
