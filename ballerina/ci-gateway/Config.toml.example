port = 9095
# Loopback default (edge-monopoly); override only behind the control-edge.
bindHost = "127.0.0.1"

# ── GitHub bridge (read-only) ──
# Token needs repo read scope. Use a dedicated PAT (recommended over the
# interactive gh OAuth token used during bring-up) and rotate on schedule.
githubBase = "https://api.github.com"
githubOwner = "markpippins"
githubToken = "<PAT>"
# Loopback default (edge-monopoly); override only behind the control-edge.
bindHost = "127.0.0.1"
jenkinsBase = "http://192.168.1.82:8080"
jenkinsUser = "admin"
jenkinsToken = "<JENKINS_API_TOKEN>"
sonarBase = "http://192.168.1.82:9000"
sonarAuthBasic = "<base64 of SONAR_TOKEN + ':'>"
snapshotDir = "./snapshots"

# Drift sentinel: committed-spec snapshots vs live behavior.
# Snapshots are generated by bin/ci-drift-snapshot.py and committed.
# JVM services (jvm/spring/service-broker/<svc>/openapi.yaml) are discovered
# too — see tackle-registry-service below (D-2026-08-23-C).
[driftTargets]
role-memory-srv = "http://localhost:3500"
conduit-srv = "http://localhost:3104"
tackle-registry-service = "http://localhost:8765"
