{
  "description": "Core platform services polled by the System Health HTTP monitor. Edit this file to add/remove services without recompiling the UI.",
  "services": [
    { "key": "redis",             "name": "Redis",              "port": 6379, "healthPath": "/health", "category": "infrastructure" },
    { "key": "mongodb",           "name": "MongoDB",            "port": 27017, "category": "infrastructure" },
    { "key": "postgres",          "name": "PostgreSQL",         "port": 5432, "category": "infrastructure" },
    { "key": "service-registry",  "name": "Service Registry",   "port": 8085, "healthPath": "/health", "category": "core" },
    { "key": "broker-gateway",    "name": "Broker Gateway",     "port": 8081, "healthPath": "/health", "category": "core" },
    { "key": "terrain",           "name": "Terrain Server",     "port": 8084, "healthPath": "/api/v1/platform/health", "category": "core" },
    { "key": "file-system-server","name": "File System Server", "port": 4040, "healthPath": "/health", "category": "core" },
    { "key": "peb-kernel",        "name": "PEB Kernel",         "port": 8080, "healthPath": "/health", "category": "core" },
    { "key": "nebula-srv",        "name": "Nebula API",         "port": 3101, "healthPath": "/health", "category": "core" },
