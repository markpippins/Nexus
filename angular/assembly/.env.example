# Assembly runtime — live only.
# The Angular dev server runs on port 4204; /api is proxied to assembly-srv
# and /nebula to nebula-srv in live mode.
ASSEMBLY_MODE=live

# Optional overrides. Default UI port is 4204.
# PORT=4204

# Live backend targets.
# API_TARGET=http://localhost:3107
# NEBULA_TARGET=http://localhost:3101
