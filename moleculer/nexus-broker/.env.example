# nexus-broker environment (dev defaults)
SERVICE_PORT=4080

# PostgreSQL canonical store (SOL IR sync reads here)
PG_HOST=localhost
PG_PORT=5432
PG_USER=pguser
PG_PASSWORD=pgpass
PG_DB_NAME=nexus

# MongoDB SOL IR projection store (D-2026-08-14-003)
# Same creds as nexus/.env SPRING_DATA_MONGODB_URI (atomic-mongodb container)
MONGO_URL=mongodb://mongoUser:somePassword@localhost:27017/nexus?authSource=admin

# SOL IR snapshot interval
SOLIR_SYNC_INTERVAL_MS=60000
