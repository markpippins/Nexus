[Unit]
Description=Outage Detector timer — runs health checks every 5 minutes
Documentation=https://github.com/codex/nexus/wiki/sysadmin-agent
After=network.target

[Timer]
# OnCalendar provides a robust steady-state cadence (fires at :00/:05/:10...)
# regardless of when the timer is started — OnBootSec/OnUnitActiveSec alone
# leave a late-started timer unarmed (NextElapse=infinity, Trigger: n/a).
OnCalendar=*:0/5
OnBootSec=1min
OnUnitActiveSec=5min
Persistent=true
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
