[Unit]
Description=Sysadmin Agent timer — runs hourly maintenance cycle
Documentation=https://github.com/codex/nexus/wiki/sysadmin-agent
After=network.target terrain.service assembly-srv.service
Wants=terrain.service assembly-srv.service

[Timer]
OnBootSec=5min
OnUnitActiveSec=1h
Persistent=true
RandomizedDelaySec=2min

[Install]
WantedBy=timers.target
