[Unit]
Description=Redis Health Monitor timer — checks Redis every 30s
Documentation=https://github.com/codex/nexus/wiki/redis-health-monitor
After=network.target redis.service
Wants=redis.service

[Timer]
OnBootSec=1min
OnUnitActiveSec=5min
Persistent=true
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
