[Unit]
Description=Daily PostgreSQL backup to barium (03:30)

[Timer]
# 03:30 — safely after backup-nexus.timer's 02:00 local dump finishes.
# OnCalendar gives a steady-state schedule; Persistent=true catches up
# after boot/outage (decision 13600407).
OnCalendar=*-*-* 03:30:00
Persistent=true
RandomizedDelaySec=15min

[Install]
WantedBy=timers.target
