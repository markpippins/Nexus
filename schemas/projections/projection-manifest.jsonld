{
  "@context": {
    "@version": 1.1,
    "nx": "https://nexus.local/schema/",
    "pr": "https://nexus.local/schema/projections/",
    "id": "@id",
    "type": "@type",
    "comment": {"@id": "http://www.w3.org/2000/01/rdf-schema#comment"},

    "ProjectionManifest":   "pr:ProjectionManifest",
    "ProjectionTarget":     "pr:ProjectionTarget",
    "ProjectionFormat":     "pr:ProjectionFormat",

    "sourceSchema":     "pr:sourceSchema",
    "targetFormat":     "pr:targetFormat",
    "generator":        "pr:generator",
    "outputPath":       "pr:outputPath",
    "lifecycle":        "pr:lifecycle",
    "active":           {"@id": "pr:active", "@type": "xsd:boolean"}
  },

  "@graph": [
    {
      "@id": "pr:ProjectionManifest",
      "@type": "rdfs:Class",
      "comment": "Records which schemas project to which dev artifacts, and what tool generates each projection.",
      "properties": ["pr:sourceSchema", "pr:targetFormat", "pr:generator", "pr:outputPath", "pr:lifecycle", "pr:active"]
    }
  ],

  "projections": [
    {
      "sourceSchema": "schemas/wrp/work-request.schema.json",
      "targetFormat": "typescript-type",
      "generator": "TypeSpec",
      "outputPath": "angular/nexus-console/src/models/work-request.model.ts",
      "lifecycle": "on-schema-change",
      "active": true
    },
    {
      "sourceSchema": "schemas/wrp/work-request.schema.json",
      "targetFormat": "pydantic-model",
      "generator": "TypeSpec",
      "outputPath": "python/conduit/work_request.py",
      "lifecycle": "on-schema-change",
      "active": true
    },
    {
      "sourceSchema": "schemas/wrp/work-request.schema.json",
      "targetFormat": "json-ld",
      "generator": "manual",
      "outputPath": "schemas/core/work-request.jsonld",
      "lifecycle": "on-schema-change",
      "active": true
    },
    {
      "sourceSchema": "schemas/wrp/wrp-event.schema.json",
      "targetFormat": "json-ld",
      "generator": "manual",
      "outputPath": "schemas/core/event.jsonld",
      "lifecycle": "on-schema-change",
      "active": true
    },
    {
      "sourceSchema": "schemas/wrp/wrp-event.schema.json",
      "targetFormat": "python-model",
      "generator": "TypeSpec",
      "outputPath": "python/cascade/events/schemas.py",
      "lifecycle": "on-schema-change",
      "active": false
    },
    {
      "sourceSchema": "schemas/core/harvest.jsonld",
      "targetFormat": "pydantic-model",
      "generator": "TypeSpec",
      "outputPath": "python/rover/schemas.py",
      "lifecycle": "on-schema-change",
      "active": false
    },
    {
      "sourceSchema": "schemas/core/knowledge-graph.jsonld",
      "targetFormat": "postgres-ddl",
      "generator": "manual",
      "outputPath": "schemas/projections/knowledge-graph.sql",
      "lifecycle": "on-schema-change",
      "active": true
    },
    {
      "sourceSchema": "schemas/core/knowledge-graph.jsonld",
      "targetFormat": "python-migration-script",
      "generator": "manual",
      "outputPath": "python/knowledge_steward/migrate_graph.py",
      "lifecycle": "on-schema-change",
      "active": true
    },
    {
      "sourceSchema": "schemas/core/service.jsonld",
      "targetFormat": "angular-service",
      "generator": "TypeSpec",
      "outputPath": "angular/nexus-console/src/models/service-mesh.model.ts",
      "lifecycle": "on-schema-change",
      "active": false
    }
  ]
}
