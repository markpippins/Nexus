[Unit]
Description=Address TTS MCP — agent-facing MCP server for TTS service
Documentation=https://github.com/nexus/typescript/address-tts-mcp
After=network.target

[Service]
Type=simple
User=codex
Group=codex
WorkingDirectory=/home/codex/dev/nexus/typescript/address-tts-mcp

# ── Environment ────────────────────────────────────────────────────────
Environment=ADDRESS_TTS_MCP_PORT=3105
Environment=TTS_URL=http://localhost:8600
Environment=NODE_ENV=production
Environment=PATH=/home/codex/.nvm/versions/node/v24.15.0/bin:/usr/local/bin:/usr/bin:/bin

# ── Executable ─────────────────────────────────────────────────────────
ExecStart=/home/codex/.nvm/versions/node/v24.15.0/bin/npx tsx src/index.ts
ExecReload=/bin/kill -HUP $MAINPID

# ── Restart behavior ───────────────────────────────────────────────────
Restart=on-failure
RestartSec=3

# ── Hardening ──────────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/home/codex/dev/nexus

[Install]
WantedBy=default.target
