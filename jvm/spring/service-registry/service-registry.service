[Unit]
Description=Service Registry — Nexus service discovery and registration (Spring Boot, port 8085)
Documentation=https://github.com/nexus/jvm/spring/service-registry
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=codex
Group=codex
WorkingDirectory=/home/codex/dev/nexus/jvm/spring/service-registry

# ── Environment ────────────────────────────────────────────────────────
Environment=SERVER_PORT=8085
Environment=JAVA_HOME=/usr
Environment=MAVEN_OPTS=-Xmx512m
Environment=PATH=/usr/bin:/bin:/usr/local/bin

# ── Executable ─────────────────────────────────────────────────────────
ExecStart=/usr/bin/mvn spring-boot:run
ExecReload=/bin/kill -HUP $MAINPID

# ── Restart behavior ───────────────────────────────────────────────────
Restart=on-failure
RestartSec=10

# ── Hardening ──────────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/home/codex/dev/nexus/jvm/spring/service-registry /home/codex/.m2

[Install]
WantedBy=default.target
