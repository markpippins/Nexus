{
  "@context": {
    "@version": 1.1,
    "nx": "https://nexus.local/schema/",

    "ks": "https://nexus.local/schema/core/knowledge-steward/",
    "id": "@id",
    "type": "@type",
    "comment": {"@id": "http://www.w3.org/2000/01/rdf-schema#comment"},

    "KnowledgeSteward":         "ks:KnowledgeSteward",
    "KnowledgeStewardQuery":    "ks:KnowledgeStewardQuery",
    "KnowledgeStewardMutation": "ks:KnowledgeStewardMutation",
    "KnowledgeStewardReport":   "ks:KnowledgeStewardReport",

    "queryText":       "ks:queryText",
    "queryType":       "ks:queryType",
    "filterSection":   "ks:filterSection",
    "filterRelation":  "ks:filterRelation",
    "filterEntityId":  "ks:filterEntityId",
    "maxResults":      {"@id": "ks:maxResults", "@type": "xsd:integer"},
    "includeEdges":    {"@id": "ks:includeEdges", "@type": "xsd:boolean"},
    "includeEmbedding":{"@id": "ks:includeEmbedding", "@type": "xsd:boolean"},

    "mutationType":    "ks:mutationType",
    "mutationPayload": "ks:mutationPayload",
    "mutationSource":  "ks:mutationSource",

    "entities":    {"@id": "ks:entities", "@container": "@list"},
    "edges":       {"@id": "ks:edges", "@container": "@list"},
    "totalCount":  {"@id": "ks:totalCount", "@type": "xsd:integer"},
    "graphSummary": {"@id": "ks:graphSummary", "@container": "@list"},

    "query":           "ks:query",
    "ingest":          "ks:ingest",
    "embed":           "ks:embed",
    "summary":         "ks:summary",
    "relate":          "ks:relate"
  },

  "@graph": [
    {
      "@id": "ks:KnowledgeSteward",
      "@type": "rdfs:Class",
      "subClassOf": {"@id": "ag:AgentRole"},
      "comment": "The Knowledge Steward is the sole writer to the knowledge graph. It ingests snapshots (from file or stream), manages embeddings, answers queries, and reports graph state. All other agents read the graph via the Steward — they never write directly.",
      "properties": [
        "nx:name", "nx:description",
        "ks:query", "ks:ingest", "ks:embed", "ks:summary", "ks:relate",
        "nx:tags"
      ]
    },
    {
      "@id": "ks:KnowledgeStewardQuery",
      "@type": "rdfs:Class",
      "comment": "A query request to the Knowledge Steward. Supports semantic (embedding-based), structural (section/relation/entity), and hybrid queries.",
      "properties": [
        "ks:queryText", "ks:queryType",
        "ks:filterSection", "ks:filterRelation", "ks:filterEntityId",
        "ks:maxResults", "ks:includeEdges", "ks:includeEmbedding"
      ]
    },
    {
      "@id": "ks:KnowledgeStewardMutation",
      "@type": "rdfs:Class",
      "comment": "A mutation to the knowledge graph. Only the Knowledge Steward can write. Mutations are: ingest (load a graph file), embed (generate/update embeddings for unembedded entities), relate (add a manual edge).",
      "properties": [
        "ks:mutationType", "ks:mutationPayload", "ks:mutationSource",
        "nx:timestamp"
      ]
    },
    {
      "@id": "ks:KnowledgeStewardReport",
      "@type": "rdfs:Class",
      "comment": "A report from the Knowledge Steward containing query results or graph status.",
      "properties": [
        "ks:entities", "ks:edges",
        "ks:totalCount", "ks:graphSummary",
        "nx:timestamp"
      ]
    }
  ]
}
