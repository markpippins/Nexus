# Pipelines MCP environment config
# Copy this file to .env and adjust paths for your machine.
# All values have sensible defaults; uncomment only what you need to change.

# PostgreSQL connection (required — no SQLite fallback)
# CONDUIT_PG_DSN=postgresql://pguser:pgpass@localhost:5433/nexus
# CONDUIT_PG_SCHEMA=conduit

# Root of the conduit data directory (sessions, logs, active work requests)
# PIPELINE_DIR=/home/codex/dev/nexus/.conduit-data

# Root of the governance graph directory (plans, prompts, changes, inspections)
# GRAPH_DIR=/home/codex/dev/nexus/graph

# HTTP server port
# PORT=3100
