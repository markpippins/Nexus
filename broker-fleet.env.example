# broker-fleet.env.example
# ------------------------------------------------------------------
# Multi-machine service-discovery config template (architect gap
# analysis 965d9f01 — item 2 "Config externalization", gap #3).
#
# Single-machine default: every value falls back to localhost, so a
# fresh checkout works with NO environment overrides. For multi-machine
# deployment, copy this file per machine (or via a fleet config —
# Consul/env template) and set each var to the machine-relevant host.
#
# Consumed by:
#   - broker-gateway (Spring, jvm/spring/service-broker/broker-gateway)
#   - broker-gateway (Quarkus, jvm/quarkus/broker-gateway)
#   - broker-gateway-proxy (AdonisJS, adonisjs/broker-gateway-proxy)
#   - Moleculer registry-client (moleculer/search/services/registry-client.service.ts)
#   - fs-crawler-adapter (python/fs/fs-crawler-adapter/adapter.py)
# ------------------------------------------------------------------

# Service Registry — the machine running the registry (default: this machine :8085)
SERVICE_REGISTRY_URL=http://localhost:8085
# Alias consumed by the Python adapter + Adonis proxy registration calls
HOST_SERVER_URL=http://localhost:8085

# The hostname this machine registers services under (registry knows WHICH
# machine each service runs on — plan 1291). Should be a resolvable name
# or IP on the network, NOT localhost, in multi-machine mode.
SERVICE_HOST=localhost

# Upstream broker gateway target (for proxies + REST clients that call it)
BROKER_GATEWAY_URL=http://localhost:8081

# PostgreSQL — the nexus DB the registry/gateway persist to
# (schema-specific URLs are set per service; the registry uses currentSchema=registry)
PG_URL=jdbc:postgresql://localhost:5432/nexus

# Redis (heartbeat / status cache)
REDIS_URL=redis://localhost:6379

# Per-service external URLs (broker-gateway routing targets; default = single-machine ports)
USER_SERVICE_URL=http://localhost:8083
LOGIN_SERVICE_URL=http://localhost:8082
FILE_SERVICE_URL=http://localhost:8081
SEARCH_SERVICE_URL=http://localhost:8084

# restfs (Spring broker-gateway file API)
RESTFS_API_URL=http://localhost:4040/fs
