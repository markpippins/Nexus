      "abstraction_level": "system",
      "domain": "nexus",
      "plan": "0143",
      "derived_from": [
        "0143"
      ],
      "problem_statement": "Extend the Phase 1 linear pipeline to support non-linear directed acyclic graphs (DAGs): branches, conditionals, loops. This requires updating every station — AST → IRL → IR → Spec Compiler → Lowering → Scheduler — to handle node fan-out/fan-in, conditional edges, back-edge prohibition, and topological ordering of non-linear graphs. The ExecutionGraph already supports multiple nodes but the pipeline currently only exercises linear chains.",
      "desired_outcome": "Compiler hardening — non-linear DAG support",
      "produced_files": [
        {
          "path": "nexus/python/meep/models.py — add EdgeCondition, BranchGroup, LoopBoundary types",
          "type": "code",
          "hash": null,
          "origin_step": "step_1"
        },
        {
          "path": "nexus/python/meep/spec_compiler.py — emit multi-branch WorkRequestGraphs",
          "type": "code",
          "hash": null,
          "origin_step": "step_1"
        },
        {
          "path": "nexus/python/meep/lowering_pass.py — freeze DAGs with conditional edges",
          "type": "code",
          "hash": null,
          "origin_step": "step_1"
        },
        {
          "path": "nexus/python/meep/scheduler.py — topological sort with branch-aware traversal",
          "type": "code",
          "hash": null,
          "origin_step": "step_1"
        },
        {
          "path": "nexus/python/meep/tests/test_dag_compiler.py — DAG-specific tests",
          "type": "code",
          "hash": null,
          "origin_step": "step_1"
        },
