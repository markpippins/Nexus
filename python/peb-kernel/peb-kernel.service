[Unit]
Description=PEB Kernel — Persistent Engineering Brain (Python, port 8098)
Documentation=https://github.com/nexus/python/peb-kernel
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=codex
Group=codex
WorkingDirectory=/home/codex/dev/nexus/python/peb-kernel

# ── Environment ────────────────────────────────────────────────────────
Environment=PEB_PORT=8098
Environment=PEB_HOST=0.0.0.0
Environment=PEB_STORE=postgres
Environment=PEB_DATABASE_URL=postgresql://pguser:pgpass@localhost:5432/nexus
Environment=PYTHONPATH=/home/codex/dev/nexus/python/peb-kernel/src
Environment=PATH=/home/codex/opt/anaconda3/bin:/usr/local/bin:/usr/bin:/bin

# ── Executable ─────────────────────────────────────────────────────────
# ExecStart points at the wrapper script, not a bare `python -m` invocation.
# The wrapper validates Python version + required packages before binding.
ExecStart=/home/codex/dev/nexus/python/peb-kernel/run-peb-kernel.sh
ExecReload=/bin/kill -HUP $MAINPID

# ── Restart behavior ───────────────────────────────────────────────────
Restart=on-failure
RestartSec=10

# ── Hardening ──────────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/home/codex/dev/nexus/python/peb-kernel

[Install]
WantedBy=default.target
