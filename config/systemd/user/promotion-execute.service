[Unit]
Description=Promotion flow stage 3: gated executor (plan 0005)
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/home/codex/dev/nexus/python/promotion-flow
ExecStart=/usr/bin/env python3 -u stage3_execute.py
Environment=NEBULA_SRV=http://localhost:3101
Environment=ASSEMBLY_SRV=http://localhost:3107
Restart=on-failure
RestartSec=60
StandardOutput=append:/tmp/promotion-execute.log
StandardError=inherit
