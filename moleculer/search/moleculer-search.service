[Unit]
Description=Moleculer Search Service — Google Search API with registry integration (port 4050)
Documentation=https://github.com/nexus/moleculer/search
After=network.target redis.service
Wants=redis.service

[Service]
Type=simple
User=codex
Group=codex
WorkingDirectory=/home/codex/dev/nexus/moleculer/search

# ── Environment ────────────────────────────────────────────────────────
Environment=NODE_ENV=production
Environment=SERVICE_PORT=4050
Environment=GOOGLE_API_KEY=AIzaSyAfVHkNv8-YVyz1eSitseZLTHcXW4NTyI4
Environment=GOOGLE_SEARCH_ENGINE_ID=e44fd2743cc9e49c8
Environment=PATH=/home/codex/.nvm/versions/node/v24.15.0/bin:/usr/local/bin:/usr/bin:/bin

# ── Executable ─────────────────────────────────────────────────────────
ExecStart=/home/codex/.nvm/versions/node/v24.15.0/bin/npx moleculer-runner services/**/*.service.ts
ExecReload=/bin/kill -HUP $MAINPID

# ── Restart behavior ───────────────────────────────────────────────────
Restart=on-failure
RestartSec=3

# ── Hardening ──────────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/home/codex/dev/nexus/moleculer/search

[Install]
WantedBy=default.target
