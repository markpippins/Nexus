{
  "@context": {
    "@version": 1.1,
    "@base": "https://nexus.local/schema/",
    "nx": "https://nexus.local/schema/",

    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "https://schema.org/",

    "id": "@id",
    "type": "@type",
    "language": "@language",
    "value": "@value",

    "comment": "rdfs:comment",
    "label": "rdfs:label",
    "subClassOf": {"@id": "rdfs:subClassOf", "@type": "@id"},

    "name": "schema:name",
    "description": "schema:description",
    "url": "schema:url",
    "version": "schema:version",

    "createdAt": {"@id": "nx:createdAt", "@type": "xsd:dateTime"},
    "updatedAt": {"@id": "nx:updatedAt", "@type": "xsd:dateTime"},
    "timestamp": {"@id": "nx:timestamp", "@type": "xsd:dateTime"},
    "expiresAt": {"@id": "nx:expiresAt", "@type": "xsd:dateTime"},

    "status": "nx:status",
    "title": "nx:title",
    "priority": "nx:priority",
    "tags": {"@id": "nx:tags", "@container": "@set"},

    "source": "nx:source",
    "provenance": "nx:provenance",
    "confidence": {"@id": "nx:confidence", "@type": "xsd:float"},

    "WorkRequest": "nx:WorkRequest",
    "Plan": "nx:Plan",
    "PlanTicket": "nx:PlanTicket",
    "Receipt": "nx:Receipt",
    "Harvest": "nx:Harvest",
    "SpecificationAgenda": "nx:SpecificationAgenda",
    "SpecificationCandidate": "nx:SpecificationCandidate",
    "HarvestedCode": "nx:HarvestedCode",
    "Event": "nx:Event",
    "Service": "nx:Service",
    "Deployment": "nx:Deployment",
    "Server": "nx:Server",
    "Framework": "nx:Framework",
    "Agent": "nx:Agent",
    "AgentRole": "nx:AgentRole",
    "Fact": "nx:Fact",
    "VectorSnapshot": "nx:VectorSnapshot",
    "Document": "nx:Document",
    "File": "nx:File",
    "Concept": "nx:Concept",
    "Requirement": "nx:Requirement",

    "derivedFrom":   {"@id": "nx:derivedFrom",   "@type": "@id", "@container": "@set"},
    "supersedes":    {"@id": "nx:supersedes",    "@type": "@id"},
    "dependsOn":     {"@id": "nx:dependsOn",     "@type": "@id", "@container": "@set"},
    "references":    {"@id": "nx:references",    "@type": "@id", "@container": "@set"},
    "produces":      {"@id": "nx:produces",      "@type": "@id", "@container": "@set"},
    "triggers":      {"@id": "nx:triggers",      "@type": "@id"},
    "deployedOn":    {"@id": "nx:deployedOn",    "@type": "@id"},
    "deploys":       {"@id": "nx:deploys",       "@type": "@id"},
    "instanceOf":    {"@id": "nx:instanceOf",    "@type": "@id"},
    "nextVersion":   {"@id": "nx:nextVersion",   "@type": "@id"},
    "previousVersion": {"@id": "nx:previousVersion", "@type": "@id"},
    "ownedBy":       {"@id": "nx:ownedBy",       "@type": "@id"},
    "assignedTo":    {"@id": "nx:assignedTo",    "@type": "@id"},
    "hasPart":       {"@id": "nx:hasPart",       "@type": "@id"},
    "partOf":        {"@id": "nx:partOf",        "@type": "@id"},
    "observedBy":    {"@id": "nx:observedBy",    "@type": "@id"},
    "recordedAt":    {"@id": "nx:recordedAt",    "@type": "xsd:dateTime"},
    "vector":        {"@id": "nx:vector",        "@type": "xsd:string"}
  }
}
