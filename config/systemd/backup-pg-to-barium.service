[Unit]
# Off-machine PostgreSQL backup: all databases, custom-format dumps,
# shipped + checksum-verified on barium (strontium outage contingency).
# Complements backup-nexus.timer (local WD14A, nexus-only, plain SQL).
# Per architect decision 13600407 (2026-08-09): systemd user timers are
# the single OS-level substrate; cron stays retired.
Description=PostgreSQL off-machine backup to barium (all DBs, verified)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/codex/dev/pgsql
ExecStart=/home/codex/dev/pgsql/pg-backup-to-barium.sh
TimeoutStartSec=4h
