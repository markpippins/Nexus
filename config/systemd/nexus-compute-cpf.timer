[Unit]
Description=Compute CPF Scores (every 75 minutes)

[Timer]
# Slowed 5x from 15 min (2026-08-12). 75 min cannot be expressed as an
# OnCalendar minute step, so OnActiveSec arms the timer shortly after
# (re)start and OnUnitActiveSec repeats every 75 min from there.
OnActiveSec=2min
OnUnitActiveSec=75min
Persistent=true

[Install]
WantedBy=timers.target
