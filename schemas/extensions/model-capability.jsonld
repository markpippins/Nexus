{
  "@context": {
    "@version": 1.1,
    "nx": "https://nexus.local/schema/",

    "mc": "https://nexus.local/schema/extensions/model-capability/",
    "id": "@id",
    "type": "@type",
    "comment": {"@id": "http://www.w3.org/2000/01/rdf-schema#comment"},

    "ModelCapability":     "mc:ModelCapability",
    "ModelCapabilitySet":  "mc:ModelCapabilitySet",
    "ExecutionProfile":    "mc:ExecutionProfile",
    "PerformanceMetrics":  "mc:PerformanceMetrics",
    "ModelEndpoint":       "mc:ModelEndpoint",

    "capabilityName":    "mc:capabilityName",
    "capabilityType":    "mc:capabilityType",
    "capabilityScore":   {"@id": "mc:capabilityScore", "@type": "xsd:float"},
    "requiresGpu":       {"@id": "mc:requiresGpu", "@type": "xsd:boolean"},
    "maxContextTokens":  {"@id": "mc:maxContextTokens", "@type": "xsd:integer"},
    "supportsStreaming": {"@id": "mc:supportsStreaming", "@type": "xsd:boolean"},
    "supportsFunctions": {"@id": "mc:supportsFunctions", "@type": "xsd:boolean"},
    "supportsSchema":    {"@id": "mc:supportsSchema", "@type": "xsd:boolean"},
    "tags":              {"@id": "mc:tags", "@container": "@set"},
    "modelFamily":       "mc:modelFamily",
    "endpointUrl":       "mc:endpointUrl",
    "endpointType":      "mc:endpointType",
    "apiKeyRef":         "mc:apiKeyRef",

    "latencyP50Ms":      {"@id": "mc:latencyP50Ms", "@type": "xsd:integer"},
    "latencyP95Ms":      {"@id": "mc:latencyP95Ms", "@type": "xsd:integer"},
    "tokensPerSecond":   {"@id": "mc:tokensPerSecond", "@type": "xsd:float"},
    "costPerToken":      {"@id": "mc:costPerToken", "@type": "xsd:float"}
  },

  "@graph": [
    {
      "@id": "mc:ModelCapability",
      "@type": "rdfs:Class",
      "comment": "A specific capability that a model can perform (e.g., structured_extraction, code_generation, classification, embedding).",
      "properties": [
        "mc:capabilityName", "mc:capabilityType", "mc:capabilityScore",
        "mc:requiresGpu", "mc:maxContextTokens",
        "mc:supportsStreaming", "mc:supportsFunctions", "mc:supportsSchema"
      ]
    },
    {
      "@id": "mc:ModelCapabilitySet",
      "@type": "rdfs:Class",
      "comment": "A set of capabilities associated with a model or endpoint.",
      "properties": [
        "mc:modelFamily", "mc:tags",
        "nx:name", "nx:description", "nx:version",
        "mc:latencyP50Ms", "mc:latencyP95Ms", "mc:tokensPerSecond", "mc:costPerToken"
      ]
    },
    {
      "@id": "mc:ExecutionProfile",
      "@type": "rdfs:Class",
      "comment": "An execution profile for routing work to the right model based on capability requirements.",
      "properties": [
        "mc:endpointUrl", "mc:endpointType", "mc:apiKeyRef",
        "mc:requiresGpu", "mc:maxContextTokens"
      ]
    },
    {
      "@id": "mc:PerformanceMetrics",
      "@type": "rdfs:Class",
      "comment": "Runtime performance metrics for a model endpoint.",
      "properties": [
        "mc:latencyP50Ms", "mc:latencyP95Ms", "mc:tokensPerSecond", "mc:costPerToken"
      ]
    }
  ]
}
