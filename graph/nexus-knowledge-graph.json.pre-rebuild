      "id": "wr-0160-1782554641-a04af22d",
      "category": "builder",
      "role": "builder",
      "status": "DISPATCHED",
      "priority": "medium",
      "abstraction_level": "task",
      "domain": "nexus",
      "plan": "0160",
      "derived_from": [
        "0160"
      ],
      "problem_statement": "Add version INTEGER, source_hash TEXT, and run_metadata JSONB columns to nebula.harvests so that repeated harvests of the same source_path by the same (or different) models produce distinct, versioned rows. Existing rows become version=1. Unique index on (source_path, model, version). Cross-references point at specific harvest IDs (a particular versioned run), not at the source_path abstractly. Cannot be implemented while DeepSeek is actively writing to the harvests table.",
      "desired_outcome": "Version harvests — add source_hash, version, run_metadata to harvests table",
      "produced_files": [],
      "tags": [
        "plan-migration",
        "builder"
      ],
      "model": "qwen2.5-coder",
