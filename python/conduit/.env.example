# Pipeline Manager environment config
# Copy this file to .env and adjust paths for your machine.
# All values have sensible defaults; uncomment only what you need to change.

# PostgreSQL connection (required — no SQLite fallback)
# CONDUIT_PG_DSN=host=localhost port=5432 user=pguser password=pgpass dbname=nexus
# CONDUIT_PG_SCHEMA=conduit

# Conduit data directory (default: /home/codex/dev/nexus/.conduit-data)
# CONDUIT_DATA_DIR=/home/codex/dev/nexus/.conduit-data

# Lock file to prevent concurrent pipeline-manager runs
# PIPELINE_LOCK_PATH=/tmp/pipeline-manager.lock

# Directory where WorkRequest DCOs are written
# PIPELINE_DCO_DIR=/home/codex/dev/nexus/.conduit-data/WORK_REQUESTS

# Path to the opencode binary (only needed for the opencode harness)
# OPENCODE_BIN=/home/codex/.opencode/bin/opencode

# Project root where executor_cloud.py should write artifacts
# PIPELINE_ROOT=/home/codex/dev
