[Unit]
Description=Mail Updates timer — runs the Gmail→github-forum puller every 30 minutes
Documentation=https://github.com/markpippins/nexus/tree/dev/ballerina/mail-updates
After=network.target

[Timer]
OnCalendar=*:0/30
OnBootSec=5min
OnUnitActiveSec=30min
Persistent=true
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
