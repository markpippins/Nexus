<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <parent>
        <groupId>com.aibizarchitect.nexus</groupId>
        <artifactId>nexus-root</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <artifactId>conformance-verifier</artifactId>
    <packaging>jar</packaging>
    <name>Nexus Conformance Verifier (W2.04)</name>
    <description>Independent JVM replay verifier for the W1.09 governance-envelope replay fixtures: W1.04 canonical serialization re-derivation, evaluation-fingerprint parity against jvm/expected-digests.json, and drift-taxonomy classification. Shares no code with the Python reference implementation.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.12.2</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>21</release>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                        <arg>-Werror</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.5</version>
                <configuration>
                    <systemPropertyVariables>
                        <!-- Absolute paths for the verifier test fixtures. Surefire
                             runs with cwd = module dir, so a *relative* path from the
                             module would resolve incorrectly; basedir is absolute. -->
                        <replay.module.basedir>${project.basedir}</replay.module.basedir>
                        <replay.fixtures.dir>${project.basedir}/../../../python/governance-envelope/replay_fixtures</replay.fixtures.dir>
                        <replay.manifest.path>${project.basedir}/../../../python/governance-envelope/jvm/expected-digests.json</replay.manifest.path>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
