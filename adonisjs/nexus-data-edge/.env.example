# nexus-data-edge environment (dev defaults)

NODE_ENV=development
HOST=0.0.0.0
PORT=8083
APP_NAME=nexus-data-edge
LOG_LEVEL=info

# 32-byte dev key — replace in production
APP_KEY=dev-key-nexus-data-edge-00000000

# PostgreSQL (canonical store)
PG_HOST=localhost
PG_PORT=5432
PG_USER=pguser
PG_PASSWORD=pgpass
PG_DB_NAME=nexus

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
