[Unit]
Description=Semantics SRV — REST API serving the semantics.* Postgres schema (port 3160)
Documentation=https://github.com/nexus/typescript/semantics-srv
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=codex
Group=codex
WorkingDirectory=/home/codex/dev/nexus/typescript/semantics-srv

# ── Environment ────────────────────────────────────────────────────────
Environment=SEMANTICS_SRV_PORT=3160
Environment=SEMANTICS_SRV_SERVICE_ID=60
Environment=NODE_ENV=production
Environment=PATH=/home/codex/.nvm/versions/node/v24.15.0/bin:/usr/local/bin:/usr/bin:/bin

# ── Executable ─────────────────────────────────────────────────────────
ExecStart=/home/codex/.nvm/versions/node/v24.15.0/bin/npx tsx src/index.ts
ExecReload=/bin/kill -HUP $MAINPID

# ── Restart behavior ───────────────────────────────────────────────────
Restart=on-failure
RestartSec=3

# ── Hardening ──────────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/home/codex/dev/nexus/typescript/semantics-srv /home/codex/.npm

[Install]
WantedBy=default.target
