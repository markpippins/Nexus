port = 9095
jenkinsBase = "http://192.168.1.82:8080"
jenkinsUser = "admin"
jenkinsToken = "<JENKINS_API_TOKEN>"
sonarBase = "http://192.168.1.82:9000"
sonarAuthBasic = "<base64 of SONAR_TOKEN + ':'>"
snapshotDir = "./snapshots"

# Drift sentinel: committed-spec snapshots vs live behavior.
# Snapshots are generated by bin/ci-drift-snapshot.py and committed.
[driftTargets]
role-memory-srv = "http://localhost:3500"
conduit-srv = "http://localhost:3104"
