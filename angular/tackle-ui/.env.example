[TEMPLATE]
# tackle-ui runtime mode
#   mock = serve in-memory mock data on port 3000 (default — no .env file needed)
#   live = proxy all requests to tackle-srv:3410 on port 4202, with stubs for endpoints not yet on the backend
VITE_TACKLE_MODE=mock

# Override the backend target when VITE_TACKLE_MODE=live
# VITE_TACKLE_TARGET=http://localhost:3410

# Override the default port (mock=3000, live=4202)
# PORT=3000

# Gemini API key (used only in mock mode for live AI test invocations)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
