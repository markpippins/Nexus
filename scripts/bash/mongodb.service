[Unit]
Description=MongoDB — document database via Docker
Documentation=https://github.com/nexus/bin/start-mongodb-docker.sh
After=network.target docker.service
Wants=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=codex
Group=codex

# ── Environment ────────────────────────────────────────────────────────
Environment=PATH=/usr/bin:/bin:/usr/local/bin

# ── Executable ─────────────────────────────────────────────────────────
ExecStart=/home/codex/dev/nexus/bin/start-mongodb-docker.sh
ExecStop=-/usr/bin/docker stop atomic-mongodb
ExecStopPost=-/usr/bin/docker rm atomic-mongodb

# ── Restart behavior ───────────────────────────────────────────────────
Restart=on-failure
RestartSec=5

# ── Timeouts ───────────────────────────────────────────────────────────
TimeoutStartSec=60
TimeoutStopSec=30

[Install]
WantedBy=default.target
