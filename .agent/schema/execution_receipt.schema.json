{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Execution Receipt",
  "description": "Mandatory receipt emitted by any executor upon completion of a WorkRequest",
  "type": "object",
  "properties": {
    "work_request_id": {
      "type": "string"
    },
    "executor_id": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Captured context/state at the time of execution"
    },
    "mutations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {"type": "string"},
          "action": {"type": "string"},
          "diff": {"type": "string"}
        }
      },
      "description": "Explicit list of state changes made by the executor"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "type": "string",
      "enum": ["SUCCESS", "FAILED", "PARTIAL"]
    },
    "lineage_parent": {
      "type": "string",
      "description": "ID of the prior execution or graph state for continuous tracking"
    }
  },
  "required": ["work_request_id", "executor_id", "timestamp", "result", "lineage_parent"]
}
