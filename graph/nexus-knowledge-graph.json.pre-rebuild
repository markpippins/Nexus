    {
      "plan_number": "0182",
      "title": "WRP Validation and Invariant Checking Engine",
      "status": "archived",
      "goal": "Build the invariant validation engine for WRP graph consistency: invariant lifecycle (PROPOSED→TESTED→VALIDATED→STABLE→DEPRECATED→REPLACED), scoring thresholds (≥0.85 stable, 0.65-0.85 validated, 0.4-0.65 tested, <0.4 discard), invariant types (structural, semantic, governance). Invariants that hold across all stable branches graduate to WRP core rules. Fixed-point constraint: new invariants must not alter the existing fixed-point set. Non-circular validation: invariants cannot be validated solely by systems they modify.",
      "files_count": 3,
      "acceptance_count": 23,
      "dependencies": [
        "\"[\\\"0164\\\"\"",
