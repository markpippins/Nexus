    },
    {
      "plan_number": "0143",
      "title": "Compiler hardening — non-linear DAG support",
      "status": "archived",
      "goal": "Extend the Phase 1 linear pipeline to support non-linear directed acyclic graphs (DAGs): branches, conditionals, loops. This requires updating every station — AST → IRL → IR → Spec Compiler → Lowering → Scheduler — to handle node fan-out/fan-in, conditional edges, back-edge prohibition, and topological ordering of non-linear graphs. The ExecutionGraph already supports multiple nodes but the pipeline currently only exercises linear chains.",
      "files_count": 8,
      "acceptance_count": 7,
      "dependencies": [
        "\"[\\\"Phase 1 (plans 0136–0142)\\\"]\""
      ],
      "tags": [],
      "created_at": "2026-06-20 20:22:18+00",
      "updated_at": "2026-06-21 04:27:11+00",
      "_src": "db"
    },
    {
      "plan_number": "0144",
      "title": "Execution kernel — real handlers",
      "status": "archived",
      "goal": "Replace the Phase 1 simulated handlers with real execution handlers that produce observable side effects. Each handler receives the frozen ExecutionGraph node, resolves its dependencies, performs its work (e.g., file I/O, API calls, subprocess invocation, state mutation), and reports completion or failure. Includes a handler registry with typed input/output contracts, error handling, and a timeout mechanism.",
      "files_count": 8,
      "acceptance_count": 10,
      "dependencies": [
        "\"[\\\"Phase 1 (plans 0136–0142)\\\"\"",
        "\"\\\"Compiler hardening — non-linear DAG support\\\"]\""
      ],
      "tags": [],
      "created_at": "2026-06-20 20:22:24+00",
      "updated_at": "2026-06-21 04:27:11+00",
      "_src": "db"
    },
    {
      "plan_number": "0145",
