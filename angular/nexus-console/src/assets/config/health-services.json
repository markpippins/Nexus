    { "key": "terrain-mcp",       "name": "Terrain MCP",        "port": null, "category": "mcp", "note": "stdio — client-spawned, no HTTP endpoint" },
    { "key": "tackle-mcp",        "name": "Tackle MCP",         "port": 3400, "healthPath": "/health", "category": "mcp" },
    { "key": "assembly-mcp",      "name": "Assembly MCP",       "port": 3107, "healthPath": "/health", "category": "mcp" }
