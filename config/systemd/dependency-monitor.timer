[Unit]
Description=Dependency Monitor timer — checks Redis, PostgreSQL, MongoDB every 30s
Documentation=https://github.com/codex/nexus/wiki/dependency-monitor
After=network.target redis.service postgresql.service mongodb.service
Wants=redis.service postgresql.service mongodb.service

[Timer]
OnBootSec=10s
OnUnitActiveSec=30s
Persistent=true
RandomizedDelaySec=5s

[Install]
WantedBy=timers.target
