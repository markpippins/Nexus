{
  "id": "document-ingest",
  "description": "DocLing ingestion workflow — parse an HTML source, extract chunks, and summarize the result.",
  "domain": "ingestion",
  "nodes": [
    {
      "id": "ingest.html",
      "type": "deterministic",
      "input_schema": {
        "type": "object",
        "properties": {"source": {"type": "string"}},
        "required": ["source"]
      },
      "output_schema": {
        "type": "object",
        "properties": {"document": {"type": "object"}}
      },
      "implementation": "bin/ingest_history.py:parse_html"
    },
    {
      "id": "ingest.extract",
      "type": "deterministic",
      "input_schema": {
        "type": "object",
        "properties": {"document": {"type": "object"}},
        "required": ["document"]
      },
      "output_schema": {
        "type": "object",
        "properties": {"chunks": {"type": "array", "items": {"type": "object"}}}
