{
  "@context": {
    "@version": 1.1,
    "nx": "https://nexus.local/schema/",

    "ev": "https://nexus.local/schema/core/event/",
    "id": "@id",
    "type": "@type",
    "comment": {"@id": "http://www.w3.org/2000/01/rdf-schema#comment"},

    "Event":           "ev:Event",
    "IdeaCaptured":    "ev:IdeaCaptured",
    "WorkflowPlanned": "ev:WorkflowPlanned",
    "StepRequested":   "ev:StepRequested",
    "StepApproved":    "ev:StepApproved",
    "StepRejected":    "ev:StepRejected",
    "StepCompleted":   "ev:StepCompleted",
    "KernelPanic":     "ev:KernelPanic",

    "eventType":    "ev:eventType",
    "eventId":      "ev:eventId",
    "eventSchemaVersion": {"@id": "ev:eventSchemaVersion", "@type": "xsd:integer"},
    "originLayer":  "ev:originLayer",
    "epochId":      "ev:epochId",
    "sourceEventIds": {"@id": "ev:sourceEventIds", "@container": "@set"},

    "workflowType": "ev:workflowType",
    "workflowId":   "ev:workflowId",
    "ideaId":       "ev:ideaId",
    "stepName":     "ev:stepName",
    "stepContent":  "ev:stepContent",
    "stepResult":   "ev:stepResult",
    "approver":     "ev:approver",
    "rejectionReason": "ev:rejectionReason",
    "panicMessage": "ev:panicMessage",
    "panicContext": "ev:panicContext",
    "payload":      "ev:payload",
    "actor":        "ev:actor",

    "subject":      "nx:subject",
    "body":         "ev:body",
    "headers":      {"@id": "ev:headers", "@container": "@set"},

    "factCheck":    "ev:factCheck"
  },

  "@graph": [
    {
      "@id": "ev:Event",
      "@type": "rdfs:Class",
      "subClassOf": {"@id": "nx:Event"},
      "comment": "A durable event in the cascade event system. All events share a common envelope and are distinguished by their eventType.",
      "properties": [
        "ev:eventId", "ev:eventType", "ev:eventSchemaVersion",
        "ev:originLayer", "ev:epochId", "ev:sourceEventIds",
        "nx:timestamp", "nx:source", "ev:payload",
        "nx:triggers", "nx:derivedFrom", "nx:references"
      ]
    },
    {
      "@id": "ev:IdeaCaptured",
      "@type": "rdfs:Class",
      "subClassOf": {"@id": "ev:Event"},
      "comment": "A new idea or intent has been captured from a source transcript, observation, or user input.",
      "properties": [
        "ev:ideaId", "ev:workflowType", "ev:workflowId",
        "nx:title", "nx:description", "ev:stepContent",
        "nx:source", "nx:tags"
      ]
    },
    {
      "@id": "ev:WorkflowPlanned",
      "@type": "rdfs:Class",
      "subClassOf": {"@id": "ev:Event"},
      "comment": "A workflow has been planned from an IdeaCaptured event, defining the steps required.",
      "properties": [
        "ev:ideaId", "ev:workflowId", "ev:body",
        "nx:derivedFrom"
      ]
    },
    {
      "@id": "ev:StepRequested",
      "@type": "rdfs:Class",
      "subClassOf": {"@id": "ev:Event"},
      "comment": "A specific step in a workflow has been requested for execution.",
      "properties": [
        "ev:ideaId", "ev:workflowId", "ev:stepName", "ev:stepContent",
        "nx:derivedFrom"
      ]
    },
    {
      "@id": "ev:StepApproved",
      "@type": "rdfs:Class",
      "subClassOf": {"@id": "ev:Event"},
      "comment": "A step has been approved (human or automated review).",
      "properties": [
        "ev:ideaId", "ev:stepName", "ev:approver"
      ]
    },
    {
      "@id": "ev:StepRejected",
      "@type": "rdfs:Class",
      "subClassOf": {"@id": "ev:Event"},
      "comment": "A step has been rejected with a reason.",
      "properties": [
        "ev:ideaId", "ev:stepName", "ev:rejectionReason"
      ]
    },
    {
      "@id": "ev:StepCompleted",
      "@type": "rdfs:Class",
      "subClassOf": {"@id": "ev:Event"},
      "comment": "A step has been completed with its result.",
      "properties": [
        "ev:ideaId", "ev:stepName", "ev:stepResult",
        "nx:references"
      ]
    },
    {
      "@id": "ev:KernelPanic",
      "@type": "rdfs:Class",
      "subClassOf": {"@id": "ev:Event"},
      "comment": "An unrecoverable error has occurred in the workflow kernel.",
      "properties": [
        "ev:panicMessage", "ev:panicContext"
      ]
    }
  ]
}
