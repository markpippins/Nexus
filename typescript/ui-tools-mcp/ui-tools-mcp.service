[Unit]
Description=UI Tools MCP — agent-facing MCP server for statusbar link management
Documentation=https://github.com/nexus/typescript/ui-tools-mcp
After=network.target ui-tools.service
Wants=ui-tools.service

[Service]
Type=simple
User=codex
Group=codex
WorkingDirectory=/home/codex/dev/nexus/typescript/ui-tools-mcp

# ── Environment ────────────────────────────────────────────────────────
Environment=UI_TOOLS_MCP_PORT=3136
Environment=UI_TOOLS_API_URL=http://localhost:3125/api
Environment=NODE_ENV=production
Environment=PATH=/home/codex/.nvm/versions/node/v24.15.0/bin:/usr/local/bin:/usr/bin:/bin

# ── Executable ─────────────────────────────────────────────────────────
ExecStart=/home/codex/.nvm/versions/node/v24.15.0/bin/npx tsx src/index.ts
ExecReload=/bin/kill -HUP $MAINPID

# ── Restart behavior ───────────────────────────────────────────────────
Restart=on-failure
RestartSec=3

# ── Hardening ──────────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/home/codex/dev/nexus

[Install]
WantedBy=default.target
