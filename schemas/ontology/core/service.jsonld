{
  "@context": {
    "@version": 1.1,
    "nx": "https://nexus.local/schema/",

    "sv": "https://nexus.local/schema/ontology/core/service/",
    "id": "@id",
    "type": "@type",
    "comment": {"@id": "http://www.w3.org/2000/01/rdf-schema#comment"},

    "Service":           "sv:Service",
    "HostedService":     "sv:HostedService",
    "Deployment":        "sv:Deployment",
    "Server":            "sv:Server",
    "Framework":         "sv:Framework",
    "ServiceInstance":   "sv:ServiceInstance",

    "serviceName":      "sv:serviceName",
    "serviceType":      "sv:serviceType",
    "serviceStatus":    "sv:serviceStatus",
    "defaultPort":      {"@id": "sv:defaultPort", "@type": "xsd:integer"},
    "healthCheckPath":  "sv:healthCheckPath",
    "apiBasePath":      "sv:apiBasePath",
    "repositoryUrl":    "sv:repositoryUrl",
    "currentVersion":   "sv:currentVersion",
    "ltsVersion":       "sv:ltsVersion",
    "frameworkName":    "sv:frameworkName",
    "frameworkCategory":"sv:frameworkCategory",
    "language":         "sv:language",
    "operations":       {"@id": "sv:operations", "@container": "@set"},

    "hostname":         "sv:hostname",
    "ipAddress":        "sv:ipAddress",
    "serverType":       "sv:serverType",
    "environment":      "sv:environment",
    "operatingSystem":  "sv:operatingSystem",
    "cpuCores":         {"@id": "sv:cpuCores", "@type": "xsd:integer"},
    "memoryMb":         {"@id": "sv:memoryMb", "@type": "xsd:integer"},
    "diskGb":           {"@id": "sv:diskGb", "@type": "xsd:integer"},
    "region":           "sv:region",
    "cloudProvider":    "sv:cloudProvider",

    "deploymentStatus": "sv:deploymentStatus",
    "healthStatus":     "sv:healthStatus",
    "deploymentPath":   "sv:deploymentPath",
    "startedAt":        {"@id": "sv:startedAt", "@type": "xsd:dateTime"},
    "lastHealthCheck":  {"@id": "sv:lastHealthCheck", "@type": "xsd:dateTime"},

    "configKey":        "sv:configKey",
    "configValue":      "sv:configValue",
    "configEnvironment":"sv:configEnvironment",
    "isSecret":         {"@id": "sv:isSecret", "@type": "xsd:boolean"}
  },

  "@graph": [
    {
      "@id": "sv:Service",
      "@type": "rdfs:Class",
      "subClassOf": {"@id": "nx:Service"},
      "comment": "A service registered in the service mesh. May be standalone or gateway-hosted.",
      "properties": [
        "sv:serviceName", "sv:serviceType", "nx:description",
        "sv:serviceStatus", "sv:defaultPort", "sv:healthCheckPath",
        "sv:apiBasePath", "sv:repositoryUrl", "sv:currentVersion",
        "nx:createdAt", "nx:updatedAt",
        "nx:dependsOn", "nx:deployedOn", "nx:tags",
        "sv:frameworkName", "sv:frameworkCategory"
      ]
    },
    {
      "@id": "sv:ServiceInstance",
      "@type": "rdfs:Class",
      "subClassOf": {"@id": "sv:Service"},
      "comment": "A specific instance of a service with its framework, deployment, and health information.",
      "properties": [
        "sv:frameworkName", "sv:frameworkCategory", "sv:language",
        "sv:operations", "sv:healthStatus",
        "nx:deployedOn", "nx:dependsOn"
      ]
    },
    {
      "@id": "sv:HostedService",
      "@type": "rdfs:Class",
      "comment": "A service embedded within a parent gateway service.",
      "properties": [
        "sv:serviceName", "sv:operations", "sv:frameworkName",
        "sv:serviceStatus", "sv:apiBasePath", "sv:healthCheckPath"
      ]
    },
    {
      "@id": "sv:Server",
      "@type": "rdfs:Class",
      "subClassOf": {"@id": "nx:Server"},
      "comment": "A physical or virtual server in the infrastructure.",
      "properties": [
        "sv:hostname", "sv:ipAddress", "sv:serverType",
        "sv:environment", "sv:operatingSystem",
        "sv:cpuCores", "sv:memoryMb", "sv:diskGb",
        "sv:region", "sv:cloudProvider",
        "nx:status", "nx:description",
        "nx:createdAt", "nx:updatedAt"
      ]
    },
    {
      "@id": "sv:Deployment",
      "@type": "rdfs:Class",
      "subClassOf": {"@id": "nx:Deployment"},
      "comment": "A deployment of a service on a server.",
      "properties": [
        "sv:deploymentStatus", "sv:healthStatus",
        "sv:defaultPort", "sv:deploymentPath",
        "sv:currentVersion",
        "sv:startedAt", "sv:lastHealthCheck",
        "nx:createdAt", "nx:updatedAt"
      ]
    },
    {
      "@id": "sv:Framework",
      "@type": "rdfs:Class",
      "subClassOf": {"@id": "nx:Framework"},
      "comment": "A software framework used by a service.",
      "properties": [
        "nx:name", "nx:description", "sv:frameworkCategory",
        "sv:language", "sv:currentVersion", "sv:ltsVersion",
        "sv:repositoryUrl"
      ]
    }
  ]
}
