[Unit]
# Vanadium CI state -> barium: jenkins_home, sonar data/ext volumes, sonar-db.
# Titanium orchestrates both remotes over SSH. Extends the strontium-outage
# backup tier per admin approval (devops forum thread 36a2f788, 2026-08-22).
Description=Vanadium CI backup to barium (jenkins/sonar/db)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/codex/dev/nexus
ExecStart=/home/codex/dev/nexus/bin/vanadium-ci-backup-to-barium.sh
TimeoutStartSec=2h
