[Unit]
Description=Barbie UI - Platform Operations Dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/codex/dev/nexus/angular/barbie
ExecStart=/home/codex/.nvm/versions/node/v24.15.0/bin/node /home/codex/dev/nexus/angular/barbie/dist/server.cjs
Environment=PORT=3010
Environment=NODE_ENV=production
# FEDERATED_BACKEND_URLS removed 2026-08-27: vanadium peer (192.168.1.209:8085) is
# down with no planned return. Graceful degradation already handles the dead
# peer in code (commit 3756a530); removing the config eliminates the wasted
# connection-attempt + timeout on every /api/v1/registry/aggregate call.
# Re-add if vanadium is rebuilt: FEDERATED_BACKEND_URLS=vd@http://<host>:8085
Environment=BACKEND_URL=http://localhost:8085
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
