{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nexus.local/schema/validation/wrp/work-request/v1",
  "title": "WorkRequest",
  "description": "Canonical WorkRequest IR — a self-contained unit of executable intent. Compatible with the JSON-LD definition at schemas/ontology/core/work-request.jsonld.",
  "type": "object",
  "required": [
    "id",
    "version",
    "protocol_version",
    "intent",
    "execution_state"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique WorkRequest identifier (UUID v4)"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "WorkRequest version number — incremented on each modification"
    },
    "protocol_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "WRP protocol version this WorkRequest conforms to (e.g., '1.0')"
    },
    "intent": {
      "type": "object",
      "description": "The originating intent — what problem this WorkRequest solves",
      "required": ["problem_statement", "desired_outcome"],
      "properties": {
        "problem_statement": {
          "type": "string",
          "description": "The problem or need that drove this WorkRequest"
        },
        "desired_outcome": {
          "type": "string",
          "description": "What success looks like"
        },
        "domain": {
          "type": "string",
          "description": "Domain classification (e.g., 'specification', 'execution')"
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"],
          "description": "Relative priority"
        },
        "abstraction_level": {
          "type": "string",
          "enum": ["L1", "L2", "L3", "L4"],
          "description": "Knowledge abstraction level per Nebula stratification ontology"
        },
        "user_intent_trace": {
          "type": "string",
          "description": "Optional reference to original user intent capture"
        }
      }
    },
    "execution_state": {
      "type": "object",
      "description": "Current execution state of this WorkRequest",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "CREATED",
            "INTAKE",
            "PLANNING",
            "CRITIQUE",
            "SPECIFICATION",
            "APPROVED",
            "QUEUED",
            "EXECUTING",
            "COMPLETED",
            "ARCHIVED",
            "FAILED"
          ],
          "description": "Current state in the WRP 11-state lifecycle"
        },
        "progress": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Progress estimate (0.0–1.0)"
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of retry attempts"
        },
        "error_state": {
          "type": "object",
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" },
            "details": { "type": "object" }
          },
          "description": "Error details when status is FAILED"
        },
        "context_snapshot_ref": {
          "type": "string",
          "description": "Reference to the context snapshot at time of execution"
        },
        "last_updated": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of last state change"
        }
      }
    },
    "decomposition": {
      "type": "object",
      "description": "How this WorkRequest is decomposed into executable steps",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["sequential", "parallel", "hybrid"],
          "description": "Decomposition strategy"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step_id": { "type": "string" },
              "step_type": { "type": "string" },
              "description": { "type": "string" },
              "depends_on": {
                "type": "array",
                "items": { "type": "string" }
              },
              "outputs": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "required": ["step_id"]
          }
        },
        "parallelism_model": {
          "type": "string",
          "description": "How parallel steps are coordinated"
        },
        "recursion_allowed": {
          "type": "boolean",
          "description": "Whether child WorkRequests may recursively decompose"
        }
      }
    },
    "requirements": {
      "type": "object",
      "description": "Functional and non-functional requirements",
      "properties": {
        "functional": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Functional requirements"
        },
        "non_functional": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Non-functional requirements"
        },
        "system_requirements": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tool_requirements": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "constraints": {
      "type": "object",
      "description": "Constraints bounding execution",
      "properties": {
        "forbidden_actions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "safety_constraints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "resource_limits": {
          "type": "object",
          "properties": {
            "tokens": { "type": "integer" },
            "time_ms": { "type": "integer" },
            "memory_mb": { "type": "integer" }
          }
        },
        "architectural_constraints": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "success_criteria": {
      "type": "object",
      "description": "How success is measured",
      "properties": {
        "validation_rules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "acceptance_tests": {
          "type": "array",
          "items": { "type": "string" }
        },
        "completion_conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "condition": { "type": "string" },
              "evaluator": { "type": "string" }
            }
          }
        },
        "failure_modes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "lineage": {
      "type": "object",
      "description": "Provenance and version history",
      "properties": {
        "derived_from": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "version": { "type": "integer" }
            }
          },
          "description": "WorkRequests this was derived from"
        },
        "supersedes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "WorkRequest IDs this supersedes"
        },
        "branches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "type": {
                "type": "string",
                "enum": ["MAIN", "EXPERIMENTAL", "REPAIR", "SIMULATION"]
              },
              "created_at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "description": "Artifacts produced by execution",
      "properties": {
        "produced_files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file_path": { "type": "string" },
              "file_hash": { "type": "string" },
              "origin_step": { "type": "string" }
            }
          }
        },
        "intermediate_outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step_id": { "type": "string" },
              "data_ref": { "type": "string" }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Operational metadata",
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "agent_id": { "type": "string" },
        "mode": {
          "type": "string",
          "enum": ["INTENT", "BINDING", "EXECUTION-BOUND"],
          "description": "Layer mode per the 3-layer IR model"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "model": {
          "type": "string",
          "description": "Model that generated this WorkRequest"
        }
      }
    },
    "events": {
      "type": "array",
      "description": "Event history for this WorkRequest (read-only, appended by event store)",
      "items": {
        "$ref": "wrp-event.schema.json"
      }
    }
  }
}
