[Unit]
Description=UI Tools CRUD API — statusbar links and UI config (port 3125)
Documentation=https://github.com/nexus/typescript/ui-tools
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=codex
Group=codex
WorkingDirectory=/home/codex/dev/nexus/typescript/ui-tools

# ── Environment ────────────────────────────────────────────────────────
Environment=NODE_ENV=production
Environment=PORT=3125
Environment=PATH=/home/codex/.nvm/versions/node/v24.15.0/bin:/usr/local/bin:/usr/bin:/bin

# ── Executable ─────────────────────────────────────────────────────────
ExecStart=/home/codex/dev/nexus/typescript/ui-tools/node_modules/.bin/tsx src/index.ts
ExecReload=/bin/kill -HUP $MAINPID

# ── Restart behavior ───────────────────────────────────────────────────
Restart=on-failure
RestartSec=3

# ── Hardening ──────────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/home/codex/dev/nexus/typescript/ui-tools

[Install]
WantedBy=default.target
