{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": [
      "ES2022"
    ],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/db.schema.test.ts",
    "src/schema-test-setup.ts",
    "src/wrp-contract-adjacency.test.ts",
    "src/receipts-routing.test.ts"
  ],
  "include": [
    "src/**/*"
  ]
}
