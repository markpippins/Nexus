# Assembly runtime mode
#   mock = Angular dev server on port 3000 with local in-memory API fixtures
#   live = terrain-backed Angular dev server on port 4204 with API proxying
ASSEMBLY_MODE=mock

# Optional override. Defaults are mode-dependent: mock=3000, live=4204.
# PORT=3000

# Mock API port used by the mock development runner.
# MOCK_API_PORT=33107

# Live backend targets.
# API_TARGET=http://localhost:3107
# NEBULA_TARGET=http://localhost:3101
