{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "SUPERSEDED by schemas/wrp/work-request.schema.json (canonical WorkRequest IR). Retained as historical reference only; see schemas/authority/authority-matrix.json.",
  "status": "quarantined_CIR5_superseded_by_wrp_schema",
  "title": "WorkRequest Directed Acyclic Cognitive Object",
  "type": "object",
  "required": [
    "id",
    "version",
    "intent",
    "decomposition",
    "requirements",
    "constraints",
    "success_criteria",
    "lineage",
    "artifacts",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "intent": {
      "type": "object",
      "required": [
        "problem_statement",
        "desired_outcome",
        "domain",
        "priority",
        "user_intent_trace",
        "abstraction_level"
      ],
      "properties": {
        "problem_statement": {
          "type": "string"
        },
        "desired_outcome": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "priority": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "user_intent_trace": {
          "type": "string"
        },
        "abstraction_level": {
          "enum": [
            "task",
            "system",
            "architecture",
            "research"
          ]
        }
      }
    },
    "decomposition": {
      "type": "object",
      "required": [
        "strategy",
        "steps",
        "parallelism_model",
        "recursion_allowed"
      ],
      "properties": {
        "strategy": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "step_id",
              "description",
              "dependencies",
              "outputs",
              "type"
            ],
            "properties": {
              "step_id": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "outputs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "type": {
                "enum": [
                  "analysis",
                  "generation",
                  "transformation",
                  "validation",
                  "execution"
                ]
              }
            }
          }
        },
        "parallelism_model": {
          "type": "string"
        },
        "recursion_allowed": {
          "type": "boolean"
        }
      }
    },
    "requirements": {
      "type": "object",
      "properties": {
        "functional": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "non_functional": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "system_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tool_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "forbidden_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "safety_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resource_limits": {
          "type": "object",
          "properties": {
            "tokens": {
              "type": "integer"
            },
            "time_ms": {
              "type": "integer"
            },
            "memory_mb": {
              "type": "integer"
            }
          }
        },
        "architectural_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "success_criteria": {
      "type": "object",
      "properties": {
        "validation_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance_tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "completion_conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "condition",
              "evaluator"
            ],
            "properties": {
              "condition": {
                "type": "string"
              },
              "evaluator": {
                "type": "string"
              }
            }
          }
        },
        "failure_modes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "properties": {
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ]
        },
        "branches": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "merge_history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string"
              },
              "strategy": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "produced_files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "hash": {
                "type": "string"
              },
              "origin_step": {
                "type": "string"
              }
            }
          }
        },
        "intermediate_outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step_id": {
                "type": "string"
              },
              "data_ref": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "agent_id": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
