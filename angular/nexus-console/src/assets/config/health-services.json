    { "key": "conduit-mcp",       "name": "Conduit MCP",        "port": 3100, "healthPath": "/health", "category": "mcp" },
    { "key": "nebula-mcp-sse",    "name": "Nebula MCP SSE",     "port": 3102, "healthPath": "/health", "category": "mcp" },
