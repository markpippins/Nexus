[Unit]
Description=WRP Bridge Daemon — conduit → kernel receipt sync loop
Documentation=https://github.com/nexus/python/conduit/bridge
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=codex
Group=codex
WorkingDirectory=/home/codex/dev/nexus/python/conduit

# ── Environment ────────────────────────────────────────────────────────
# Fallback only — the authoritative DSN lives in .env (EnvironmentFile
# below, read after this line so it wins). Receipt-isolation option A:
# flip dbname there (see DEPLOY_DB_CONFIG.md).
Environment=CONDUIT_PG_DSN=host=localhost port=5432 user=pguser password=pgpass dbname=nexus
Environment=POLL_INTERVAL=30
Environment=LOG_LEVEL=INFO

# Note: wrp-kernel is now an in-process Python library imported by the
# bridge daemon (see python/conduit/wrp_kernel/engine.py). There is no
# KERNEL_API_URL or HTTP endpoint on port 3103.
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/codex/dev/nexus/python/conduit/.env

# ── Executable ─────────────────────────────────────────────────────────
ExecStart=/usr/bin/python3 -m bridge.daemon
ExecReload=/bin/kill -HUP $MAINPID

# ── Restart behavior ───────────────────────────────────────────────────
Restart=on-failure
RestartSec=10

# ── Hardening ──────────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/home/codex/dev/nexus

# Nice the daemon — it's a background poller, not latency-sensitive
Nice=10

[Install]
WantedBy=multi-user.target
