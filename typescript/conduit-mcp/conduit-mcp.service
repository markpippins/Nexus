[Unit]
Description=Conduit MCP — work request orchestration MCP server
Documentation=https://github.com/nexus/typescript/conduit-mcp
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=codex
Group=codex
WorkingDirectory=/home/codex/dev/nexus/typescript/conduit-mcp

# ── Environment ────────────────────────────────────────────────────────
Environment=CONDUIT_MCP_PORT=3100
Environment=NODE_ENV=production
Environment=PATH=/home/codex/.nvm/versions/node/v24.15.0/bin:/usr/local/bin:/usr/bin:/bin

# ── Executable ─────────────────────────────────────────────────────────
ExecStart=/home/codex/.nvm/versions/node/v24.15.0/bin/npx tsx src/index.ts
ExecReload=/bin/kill -HUP $MAINPID

# ── Restart behavior ───────────────────────────────────────────────────
Restart=on-failure
RestartSec=3

# ── Hardening ──────────────────────────────────────────────────────────
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/home/codex/dev/nexus/typescript/conduit-mcp

[Install]
WantedBy=default.target
