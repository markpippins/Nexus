{
  "@context": [
    "https://nexus.local/schema/ontology/context/nexus-base.jsonld",
    "https://nexus.local/schema/ontology/core/work-request.jsonld",
    "https://nexus.local/schema/ontology/relationships/work-request-to-plan.jsonld"
  ],
  "id": "nexus:wr/2026/06/20/example-001",
  "type": "WorkRequest",
  "version": 1,
  "intent": {
    "type": "WorkRequestIntent",
    "problemStatement": "Implement a structural QA gate for harvest markdown files before promotion to ROVER/processed/harvests/",
    "desiredOutcome": "Every harvest file is AST-validated before promotion, catching truncated code blocks and malformed headings automatically",
    "domain": "pipeline-quality",
    "priority": "high",
    "userIntentTrace": "Architect gap analysis 2026-06-20: Gap 1 — structural NLP should gate LLM output quality",
    "abstractionLevel": "task"
  },
  "decomposition": {
    "type": "WorkRequestDecomposition",
    "strategy": "sequential",
    "parallelismModel": "single",
    "recursionAllowed": false,
    "steps": [
      {
        "type": "WorkRequestStep",
        "stepId": "analyze-existing-schemas",
        "description": "Analyze existing harvest JSON to determine which structural checks are possible from the current SpecAgenda schema",
        "dependsOn": [],
        "outputs": ["checklist-of-validations"],
        "stepType": "analysis"
      },
      {
        "type": "WorkRequestStep",
        "stepId": "implement-qa-gate",
        "description": "Implement a structural QA gate that validates harvest files before promotion",
        "dependsOn": ["analyze-existing-schemas"],
        "outputs": ["qa_gate.py", "qa_gate_test.py"],
        "stepType": "generation"
      },
      {
        "type": "WorkRequestStep",
        "stepId": "validate-on-corpus",
        "description": "Run the QA gate against all 47 existing harvest files and report pass/fail per file",
        "dependsOn": ["implement-qa-gate"],
        "outputs": ["qa-report.json"],
        "stepType": "execution"
      }
    ]
  },
  "requirements": {
    "type": "WorkRequestRequirements",
    "functional": [
      "Must detect truncated code blocks (missing closing ```)",
      "Must detect empty intent_description fields",
      "Must flag candidates with fewer than 3 requirements"
    ],
    "nonFunctional": [
      "Must complete validation in under 100ms per harvest file",
      "Must produce JSON output suitable for the conduit watcher"
    ],
    "systemRequirements": [],
    "toolRequirements": ["Python 3.11+", "AST parser from MEEP Station 0"]
  },
  "constraints": {
    "type": "WorkRequestConstraints",
    "forbiddenActions": [],
    "safetyConstraints": [
      "Must not modify harvest files — read-only validation only"
    ],
    "resourceLimits": {
      "type": "WorkRequestResourceLimits",
      "tokens": 0,
      "timeMs": 5000,
      "memoryMb": 128
    },
    "architecturalConstraints": [
      "Must use the existing nexus:Harvest schema for input parsing"
    ]
  },
  "successCriteria": {
    "type": "WorkRequestSuccessCriteria",
    "validationRules": [
      "All 47 existing harvest files produce a valid QA report",
      "At least 3 harvests are flagged for structural issues"
    ],
    "acceptanceTests": [
      "python3 qa_gate_test.py --harvest-dir nexus/audit/ROVER/processed/harvests/"
    ],
    "completionConditions": [],
    "failureModes": [
      "QA gate misses a genuinely malformed harvest",
      "QA gate produces false positives on valid harvests"
    ]
  },
  "executionState": {
    "type": "WorkRequestExecutionState",
    "status": "pending",
    "currentStep": null,
    "progress": 0.0,
    "retries": 0,
    "errorState": null,
    "contextSnapshotRef": null,
    "lastUpdated": "2026-06-20T20:30:00Z"
