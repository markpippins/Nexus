[Unit]
Description=Voyager REST API — query filesystem acquisition data
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=codex
WorkingDirectory=/home/codex/dev/nexus/typescript/voyager-srv
Environment=PORT=3114
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
NoNewPrivileges=true

[Install]
WantedBy=default.target
